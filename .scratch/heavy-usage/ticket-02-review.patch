+export type TimelineRecord =
+  | { key: string; kind: "comment"; occurredAt: string; comment: TaskCommentView }
+  | { key: string; kind: "activity"; occurredAt: string; activity: TaskActivityView }
+  | {
+      key: string;
+      kind: "attempt";
+      occurredAt: string;
+      activation: ActivationView;
