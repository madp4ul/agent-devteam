{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-coordination.local/schemas/process-definition.schema.json",
  "title": "Agent coordination process definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "defaultTaskWorkspaceStartingRef",
    "coordinationGuidance",
    "agents",
    "boards"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "$ref": "#/$defs/nonEmptyText" },
    "defaultTaskWorkspaceStartingRef": { "$ref": "#/$defs/nonEmptyText" },
    "coordinationGuidance": { "$ref": "#/$defs/nonEmptyText" },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    },
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/board" }
    }
  },
  "$defs": {
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "summary", "instructions"],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "role": { "$ref": "#/$defs/nonEmptyText" },
        "summary": { "$ref": "#/$defs/nonEmptyText" },
        "instructions": { "$ref": "#/$defs/nonEmptyText" },
        "model": { "$ref": "#/$defs/nonEmptyText" },
        "reasoningEffort": {
          "enum": ["minimal", "low", "medium", "high", "xhigh"]
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "guidance", "columns"],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "guidance": { "$ref": "#/$defs/nonEmptyText" },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "allOf": [
            { "$ref": "#/$defs/entityId" },
            { "not": { "const": "completion" } }
          ]
        },
        "name": { "$ref": "#/$defs/nonEmptyText" },
        "watchingAgent": { "$ref": "#/$defs/entityId" }
      }
    }
  }
}
